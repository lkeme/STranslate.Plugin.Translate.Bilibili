<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_PromptNotConfigured">请先完善 Prompt 配置。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_NoTextOutput">API 未返回任何文本内容。</sys:String>

    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateEditorTitle">编辑翻译模板</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateManage">管理</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateListHeader">翻译模板</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateListDescription">选择要编辑的模板。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateNew">新建</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateCopy">复制</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateDelete">删除</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateNameHeader">模板名称</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateNameDescription">用于模板选择和主界面快捷切换。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_InstructionHeader">翻译要求</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_InstructionDescription">每行是一条可选要求，会按官方规则转换为“注意”约束。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_GlossaryHeader">术语表</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_GlossaryDescription">为术语指定固定译法，会按官方规则作为硬性约束发送。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_GlossaryHint">仅术语对照使用此表；语气、格式等请填写在“翻译要求”。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_GlossarySource">原文术语</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_GlossaryTarget">指定译法</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_GlossaryAdd">添加术语</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_GlossaryRemove">删除</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateSetActive">设为当前模板</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateNewName">新模板</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateRequired">至少保留一个翻译模板。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateNameRequired">请填写模板名称。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateNameDuplicate">模板名称不能重复。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_GlossaryTermIncomplete">术语对照的原文和译文都不能为空。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateDefaultLabel">默认</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateInheritDefaultGlossary">继承通用术语库</sys:String>

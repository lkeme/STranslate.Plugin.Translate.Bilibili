<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_PromptNotConfigured">請先完善 Prompt 設定。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_NoTextOutput">API 未傳回任何文字內容。</sys:String>

    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateEditorTitle">編輯翻譯範本</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateManage">管理</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateListHeader">翻譯範本</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateListDescription">選取要編輯的範本。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateNew">新增</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateCopy">複製</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateDelete">刪除</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateNameHeader">範本名稱</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateNameDescription">用於範本選擇及主視窗快速切換。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_InstructionHeader">翻譯要求</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_InstructionDescription">每行是一項可選要求，會依官方規則轉換為「注意」約束。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_GlossaryHeader">術語表</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_GlossaryDescription">為術語指定固定譯法，會依官方規則作為硬性約束傳送。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_GlossaryHint">僅術語對照使用此表；語氣、格式等請填寫在「翻譯要求」。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_GlossarySource">原文術語</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_GlossaryTarget">指定譯法</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_GlossaryAdd">新增術語</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_GlossaryRemove">刪除</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateSetActive">設為目前範本</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateNewName">新範本</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateRequired">至少保留一個翻譯範本。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateNameRequired">請填寫範本名稱。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateNameDuplicate">範本名稱不能重複。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_GlossaryTermIncomplete">術語對照的原文與譯文都不能為空。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateDefaultLabel">預設</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateInheritDefaultGlossary">繼承通用術語庫</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_Bilibili_TemplateDefaultRequired">必須保留預設翻譯範本。</sys:String>
</ResourceDictionary>

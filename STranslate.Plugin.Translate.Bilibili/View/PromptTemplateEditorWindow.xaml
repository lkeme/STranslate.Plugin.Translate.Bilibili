<Window
    x:Class="STranslate.Plugin.Translate.Bilibili.View.PromptTemplateEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:STranslate.Plugin.Translate.Bilibili.ViewModel"
    Title="{DynamicResource STranslate_Plugin_Translate_Bilibili_TemplateEditorTitle}"
    Width="900"
    Height="660"
    MinWidth="780"
    MinHeight="560"
    ui:WindowHelper.SystemBackdropType="Mica"
    ui:WindowHelper.UseModernWindowStyle="True"
    d:DataContext="{d:DesignInstance Type=vm:PromptTemplateEditorViewModel}"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="EditorCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource {x:Static ui:ThemeKeys.CardBackgroundFillColorDefaultBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static ui:ThemeKeys.CardStrokeColorDefaultBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="EditorHintTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundBaseMediumBrushKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="EditorSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Fixed-width navigator. The list, not the column, owns vertical scrolling. -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource EditorCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        Icon="{x:Static ui:FluentSystemIcons.Notebook_24_Regular}" />
                    <StackPanel Grid.Column="2">
                        <TextBlock
                            Style="{StaticResource EditorSectionTitleStyle}"
                            Text="{DynamicResource STranslate_Plugin_Translate_Bilibili_TemplateListHeader}" />
                        <TextBlock
                            Style="{StaticResource EditorHintTextStyle}"
                            Text="{DynamicResource STranslate_Plugin_Translate_Bilibili_TemplateListDescription}" />
                    </StackPanel>
                </Grid>

                <ListBox
                    Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Templates}"
                    SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center" Text="{DynamicResource STranslate_Plugin_Translate_Bilibili_TemplateDefaultLabel}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ui:FontIcon Grid.Column="2" Icon="{x:Static ui:FluentSystemIcons.CheckmarkCircle_20_Regular}">
                                    <ui:FontIcon.Style>
                                        <Style TargetType="ui:FontIcon">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:FontIcon.Style>
                                </ui:FontIcon>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="4" Orientation="Horizontal">
                    <Button
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.Name="{DynamicResource STranslate_Plugin_Translate_Bilibili_TemplateNew}"
                        Command="{Binding NewTemplateCommand}"
                        ToolTip="{DynamicResource STranslate_Plugin_Translate_Bilibili_TemplateNew}">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Add_24_Regular}" />
                    </Button>
                    <Button
                        Width="32"
                        Height="32"
                        Margin="8,0,0,0"
                        Padding="0"
                        AutomationProperties.Name="{DynamicResource STranslate_Plugin_Translate_Bilibili_TemplateCopy}"
                        Command="{Binding CopyTemplateCommand}"
                        ToolTip="{DynamicResource STranslate_Plugin_Translate_Bilibili_TemplateCopy}">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Copy_24_Regular}" />
                    </Button>
                    <Button
                        Width="32"
                        Height="32"
                        Margin="8,0,0,0"
                        Padding="0"
                        AutomationProperties.Name="{DynamicResource STranslate_Plugin_Translate_Bilibili_TemplateDelete}"
                        Command="{Binding DeleteTemplateCommand}"
                        ToolTip="{DynamicResource STranslate_Plugin_Translate_Bilibili_TemplateDelete}">
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Delete_24_Regular}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- A single editor scrollbar exposes all long-form content; its child grid still fills the viewport when content is short. -->
        <ScrollViewer
            x:Name="EditorScrollViewer"
            Grid.Row="0"
            Grid.Column="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid MinHeight="{Binding ActualHeight, ElementName=EditorScrollViewer}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="1.35*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource EditorCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            Icon="{x:Static ui:FluentSystemIcons.TextDescription_24_Regular}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                Style="{StaticResource EditorSectionTitleStyle}"
                                Text="{DynamicResource STranslate_Plugin_Translate_Bilibili_TemplateNameHeader}" />
                            <TextBlock
                                Style="{StaticResource EditorHintTextStyle}"
                                Text="{DynamicResource STranslate_Plugin_Translate_Bilibili_TemplateNameDescription}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            MaxLength="80"
                            Text="{Binding SelectedTemplate.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="2"
                            Command="{Binding SetActiveTemplateCommand}"
                            ToolTip="{DynamicResource STranslate_Plugin_Translate_Bilibili_TemplateSetActive}">
                            <ui:IconAndText Content="{DynamicResource STranslate_Plugin_Translate_Bilibili_TemplateSetActive}" Icon="{x:Static ui:FluentSystemIcons.CheckmarkCircle_24_Regular}" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource EditorCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            Icon="{x:Static ui:FluentSystemIcons.ChatMultiple_24_Regular}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                Style="{StaticResource EditorSectionTitleStyle}"
                                Text="{DynamicResource STranslate_Plugin_Translate_Bilibili_InstructionHeader}" />
                            <TextBlock
                                Style="{StaticResource EditorHintTextStyle}"
                                Text="{DynamicResource STranslate_Plugin_Translate_Bilibili_InstructionDescription}" />
                        </StackPanel>
                    </Grid>

                    <TextBox
                        Grid.Row="2"
                        MinHeight="120"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        Text="{Binding SelectedTemplate.Instruction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource EditorCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            Icon="{x:Static ui:FluentSystemIcons.BookLetter_24_Regular}" />
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                Style="{StaticResource EditorSectionTitleStyle}"
                                Text="{DynamicResource STranslate_Plugin_Translate_Bilibili_GlossaryHeader}" />
                            <TextBlock
                                Style="{StaticResource EditorHintTextStyle}"
                                Text="{DynamicResource STranslate_Plugin_Translate_Bilibili_GlossaryHint}" />
                        </StackPanel>
                        <CheckBox
                            Grid.Column="4"
                            VerticalAlignment="Top"
                            Content="{DynamicResource STranslate_Plugin_Translate_Bilibili_TemplateInheritDefaultGlossary}"
                            IsChecked="{Binding SelectedTemplate.InheritDefaultGlossary, Mode=TwoWay}">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static ui:ThemeKeys.SystemControlForegroundBaseHighBrushKey}}" />
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTemplate.IsDefault}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            FontWeight="SemiBold"
                            Text="{DynamicResource STranslate_Plugin_Translate_Bilibili_GlossarySource}" />
                        <TextBlock
                            Grid.Column="2"
                            FontWeight="SemiBold"
                            Text="{DynamicResource STranslate_Plugin_Translate_Bilibili_GlossaryTarget}" />
                    </Grid>

                    <ItemsControl Grid.Row="4" ItemsSource="{Binding SelectedTemplate.Glossary}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        Text="{Binding Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="&#x2192;" />
                                    <TextBox
                                        Grid.Column="2"
                                        Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Column="3"
                                        Margin="8,0,0,0"
                                        Command="{Binding DataContext.RemoveGlossaryTermCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{DynamicResource STranslate_Plugin_Translate_Bilibili_GlossaryRemove}">
                                        <ui:IconAndText Content="{DynamicResource STranslate_Plugin_Translate_Bilibili_GlossaryRemove}" Icon="{x:Static ui:FluentSystemIcons.Delete_24_Regular}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button
                        Grid.Row="6"
                        HorizontalAlignment="Left"
                        Command="{Binding AddGlossaryTermCommand}"
                        ToolTip="{DynamicResource STranslate_Plugin_Translate_Bilibili_GlossaryAdd}">
                        <ui:IconAndText Content="{DynamicResource STranslate_Plugin_Translate_Bilibili_GlossaryAdd}" Icon="{x:Static ui:FluentSystemIcons.Add_24_Regular}" />
                    </Button>
                </Grid>
            </Border>
            </Grid>
        </ScrollViewer>

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="0,16,0,0"
            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
            Text="{Binding ValidationMessage}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ValidationMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
                Content="{DynamicResource Cancel}"
                IsCancel="True" />
            <Button
                Margin="8,0,0,0"
                Click="SaveButton_Click"
                Content="{DynamicResource Save}"
                IsDefault="True"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>

<UserControl
    x:Class="STranslate.Plugin.Translate.Bilibili.View.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:STranslate.Plugin.Translate.Bilibili.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SettingInputAreaStyle" TargetType="Grid">
            <Setter Property="Width" Value="280" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <ikw:SimpleStackPanel Spacing="12">
        <!--  Model 配置  -->
        <ui:SettingsCard Header="{DynamicResource Model}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon FontFamily="{StaticResource {x:Static ui:ThemeKeys.FluentSystemIconsKey}}" Glyph="&#xF0797;" />
            </ui:SettingsCard.HeaderIcon>
            <Grid Style="{StaticResource SettingInputAreaStyle}">
                <ComboBox
                    HorizontalAlignment="Stretch"
                    IsEditable="True"
                    ItemsSource="{Binding Models}"
                    SelectedItem="{Binding Model, Mode=TwoWay}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="LostFocus">
                            <i:InvokeCommandAction Command="{Binding AddModelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}, Path=Text}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="{Binding}" />
                                <Button
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    Padding="4"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.DeleteModelCommand, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    CommandParameter="{Binding}">
                                    <ui:FontIcon
                                        FontSize="{DynamicResource STControlFontSize12}"
                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                        Icon="{x:Static ui:FluentSystemIcons.Delete_24_Regular}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </ui:SettingsCard>

        <!--  提示词选择和编辑  -->
        <ui:SettingsCard Description="{DynamicResource Prompt_Description}" Header="{DynamicResource Prompt_Header}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Chat_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>

            <Grid Style="{StaticResource SettingInputAreaStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    ui:ControlHelper.PlaceholderText="{DynamicResource Prompt_Placeholder}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Main.Prompts}"
                    SelectedItem="{Binding Main.SelectedPrompt, Mode=TwoWay}" />

                <Button
                    Grid.Column="2"
                    Command="{Binding ManageTemplatesCommand}"
                    ToolTip="{DynamicResource STranslate_Plugin_Translate_Bilibili_TemplateManage}">
                    <ui:IconAndText Content="{DynamicResource STranslate_Plugin_Translate_Bilibili_TemplateManage}" Icon="{x:Static ui:FluentSystemIcons.Edit_24_Regular}" />
                </Button>
            </Grid>
        </ui:SettingsCard>

        <!--  温度控制  -->
        <ui:SettingsCard Description="{DynamicResource Temperature_Description}" Header="{DynamicResource Temperature}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Temperature_20_Regular}" />
            </ui:SettingsCard.HeaderIcon>

            <Grid Style="{StaticResource SettingInputAreaStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Slider
                    x:Name="PART_TempSlider"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    IsSnapToTickEnabled="True"
                    Maximum="2.0"
                    Minimum="0.0"
                    TickFrequency="0.1"
                    TickPlacement="Both"
                    Value="{Binding Temperature}" />

                <TextBlock
                    Grid.Column="2"
                    Width="32"
                    TextAlignment="Right"
                    VerticalAlignment="Center"
                    Text="{Binding ElementName=PART_TempSlider, Path=Value, StringFormat=F1}" />
            </Grid>
        </ui:SettingsCard>

        <!--  连接验证  -->
        <ui:SettingsCard Description="{DynamicResource PluginTranslateValidateDescription}" Header="{DynamicResource PluginTranslateValidate}">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.CheckmarkCircle_24_Regular}" />
            </ui:SettingsCard.HeaderIcon>

            <Grid Style="{StaticResource SettingInputAreaStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding ValidateCommand}" Style="{StaticResource AccentButtonStyle}">
                    <ui:IconAndText Content="{DynamicResource PluginTranslateValidate}" Icon="{x:Static ui:FluentSystemIcons.Play_24_Regular}" />
                </Button>

                <Border Grid.Column="2" HorizontalAlignment="Left">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="Background" Value="{DynamicResource {x:Static ui:ThemeKeys.SystemFillColorAttentionBackgroundBrushKey}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ValidateResult}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{DynamicResource STControlFontSize12}"
                        Text="{Binding ValidateResult}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsValidateSuccess}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </ui:SettingsCard>
    </ikw:SimpleStackPanel>
</UserControl>
